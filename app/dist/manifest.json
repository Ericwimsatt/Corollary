{
  "manifest_version": 3,
  "name": "Corollary",
  "version": "1.0.0",
  "description": "Overlay for best ball drafts: roster tracker, stacking targets, draft capital chart, and opponent schedule.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.draftkings.com/*",
    "https://app.underdogsports.com/*",
    "https://underdogsports.com/*",
    "https://www.underdogsports.com/*",
    "https://underdogfantasy.com/*",
    "https://www.underdogfantasy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.draftkings.com/*draft*",
        "https://app.underdogsports.com/*",
        "https://underdogsports.com/*",
        "https://www.underdogsports.com/*",
        "https://underdogfantasy.com/*",
        "https://www.underdogfantasy.com/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": [
        "https://www.draftkings.com/*",
        "https://app.underdogsports.com/*",
        "https://underdogsports.com/*",
        "https://www.underdogsports.com/*",
        "https://underdogfantasy.com/*",
        "https://www.underdogfantasy.com/*"
      ]
    }
  ]
}
